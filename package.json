{
  "name": "the-brain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Brain: ORIGIN, the main agent, and the branches it grows",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "origin": "node server/origin-runner.mjs",
    "set-key": "node server/set-key.mjs",
    "get-voices": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/get-voices.ps1",
    "set-etsy": "node server/set-etsy.mjs",
    "set-printify": "node server/set-printify.mjs",
    "set-openai": "node server/set-openai.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node desktop/dev.cjs",
    "desktop:dist": "npm run build && electron-builder",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/make-shortcut.ps1"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "app.thebrain.desktop",
    "productName": "The Brain",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "package.json",
      "server/**/*",
      "build/icon.ico",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "The Brain"
    }
  }
}
